# Public-safe examples only. Keep secrets empty until configured.
NEBULA_EDITION=command
PORT=3000
HOST=127.0.0.1
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=
OLLAMA_URL=http://host.docker.internal:11434
OPENAI_COMPATIBLE_URL=http://host.docker.internal:11434/v1
COMFYUI_URL=http://host.docker.internal:8188
SEARXNG_URL=http://host.docker.internal:8080
EMBED_MODEL=nomic-embed-text
JARVIS_MODEL=qwen3:8b
JARVIS_CODE_MODEL=qwen2.5-coder:14b-instruct-q4_K_M
JARVIS_MAX_STEPS=8
JARVIS_WORKSPACE=/data/workspaces
JARVIS_REQUIRE_APPROVAL=1
JARVIS_HOST_MODE=0
GPU_EXCLUSIVE=1
REQUEST_TIMEOUT_MS=120000

# Private Command access. Keep the token out of source control.
COMMAND_ACCESS_TOKEN=
COMMAND_ALLOW_INSECURE_LOCAL=true
COMMAND_ALLOW_CLOUD=false

# Optional telemetry endpoint. Leave empty until a trusted local collector is configured.
GPU_STATUS_URL=
